GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME
PROM_URL=http://localhost:9090
SERVERS_FILE=/opt/aiops/config/servers.json
SSH_KEY_PATH=/opt/aiops/.ssh/id_ed25519
RAG_DB_PATH=/opt/aiops/data/chroma
KNOWLEDGE_FILE=/opt/aiops/knowledge/nginx_runbook.md
RAG_ENABLED=true
AUTO_REMEDIATE=false
REMEDIATION_VERIFY_DELAY=10
